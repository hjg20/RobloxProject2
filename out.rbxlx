          <string name="Source"><![CDATA[-- PNG pixel fallbacks were removed because they created too many GUI objects.
-- Use Roblox image asset ids in ReplicatedStorage.GuiIcons instead.
return {
	Icons = {},
	Signs = {},
	Backgrounds = {},
